# RTX 3090 (sm_86) 用。CUDA 10.0 系は Ampere 非対応なので、
# NVIDIA が Ampere 対応でビルドした TF1 コンテナを土台にする。
FROM nvcr.io/nvidia/tensorflow:23.03-tf1-py3

ENV DEBIAN_FRONTEND=noninteractive

# Unity 2018.3 のプレイヤーが実行時に dlopen する X11/GL ライブラリ
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11-utils \
        libgl1-mesa-glx \
        libgl1-mesa-dri \
        libglu1-mesa \
        libx11-6 \
        libxcursor1 \
        libxrandr2 \
        libxinerama1 \
        libxi6 \
        libxxf86vm1 \
        libxext6 \
        libxrender1 \
        libsm6 \
        libasound2 \
        libglib2.0-0 \
        libegl1 \
        libgles2 \
        libxv1 \
        libxtst6 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Xvfb のソフトウェア GL では Unity が core profile を作れないため、
# VirtualGL の EGL バックエンド経由で NVIDIA ドライバに描画させる。
ARG VIRTUALGL_VERSION=3.1
RUN curl -fsSLO "https://github.com/VirtualGL/virtualgl/releases/download/${VIRTUALGL_VERSION}/virtualgl_${VIRTUALGL_VERSION}_amd64.deb" \
    && apt-get update \
    && apt-get install -y --no-install-recommends "./virtualgl_${VIRTUALGL_VERSION}_amd64.deb" \
    && rm -f "virtualgl_${VIRTUALGL_VERSION}_amd64.deb" \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/share/glvnd/egl_vendor.d \
    && printf '{\n  "file_format_version" : "1.0.0",\n  "ICD" : {\n    "library_path" : "libEGL_nvidia.so.0"\n  }\n}\n' \
       > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

# TensorFlow はイメージ同梱のものを使う。requirements.txt のピンは
# Python 3.6 前提なのでここでは使わず、足りないものだけ入れる。
RUN pip install --no-cache-dir \
        "protobuf==3.20.3" \
        "gym==0.10.9" \
        "opencv-python==4.8.1.78" \
        "ray==1.13.0" \
        "tensorboardX==2.6.2.2" \
        "jsonpickle==2.2.0" \
        "pyyaml>=5.1" \
        "tensorflow-probability==0.8.0"

ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} animal \
    && useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash animal

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV DISPLAY=:99 \
    XVFB_SCREEN=1280x1024x24 \
    PYTHONPATH=/workspace \
    PATH=/opt/VirtualGL/bin:${PATH} \
    VGL_DEVICE=egl0 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

USER animal
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
